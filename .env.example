# Required: Base mainnet RPC URL (see README for how to get one)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Optional: hostname(s) served as the public, no-key tier (comma-separated).
# Requests to any other hostname require an API key when keys are configured.
# PUBLIC_DOMAIN=rpc.intuition.box

# Optional: Override snapshot URL
# SNAPSHOT_URL=https://constellationlabs-dashboard-beta.s3.amazonaws.com/intuition-03-11-2026.tar.gz
